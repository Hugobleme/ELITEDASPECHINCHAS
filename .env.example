# ==============================================================================
# ELITE DAS PECHINCHAS — VARIÁVEIS DE AMBIENTE (.env.example)
# Modelo oficial de configuração padronizado para Staging e Produção.
# NUNCA exponha credenciais reais ou adicione segredos a variáveis NEXT_PUBLIC_.
# Copie para .env no backend e para .env.local no frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambiente de Execução
# ------------------------------------------------------------------------------
# Valores aceitos: development | test | staging | production
ENVIRONMENT=development

# Chave secreta de autorização para o endpoint /offers/test-ingest
# ATENÇÃO: Esse endpoint é DESABILITADO automaticamente em staging e production.
TEST_INGEST_KEY=change-me-in-development-only

# ------------------------------------------------------------------------------
# 2. Banco de Dados Relacional (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# [DESENVOLVIMENTO LOCAL COM DOCKER]:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=elitedaspechinchas
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/elitedaspechinchas

# [DESENVOLVIMENTO LOCAL FORA DO DOCKER]:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elitedaspechinchas

# [STAGING / HOMOLOGAÇÃO COM SUPABASE]:
# Use o connection pooler do Supabase (porta 6543 para modo Transaction ou 5432 para Session):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# [PRODUÇÃO COM SUPABASE]:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF_PROD]:[DB_PASSWORD_PROD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. Cache & Mensageria (Redis & Celery)
# ------------------------------------------------------------------------------
# [DESENVOLVIMENTO LOCAL COM DOCKER]:
REDIS_URL=redis://redis:6379/0

# [DESENVOLVIMENTO LOCAL FORA DO DOCKER]:
# REDIS_URL=redis://localhost:6379/0

# [STAGING / HOMOLOGAÇÃO - Upstash / Redis Cloud]:
# REDIS_URL=rediss://default:[STAGING_REDIS_PASSWORD]@[STAGING_REDIS_HOST]:6379/0

# [PRODUÇÃO - Redis Dedicado]:
# REDIS_URL=rediss://default:[PROD_REDIS_PASSWORD]@[PROD_REDIS_HOST]:6379/0

# ------------------------------------------------------------------------------
# 4. Autenticação & Segurança (JWT / SECRET_KEY / OAuth)
# ------------------------------------------------------------------------------
# Obrigatório em staging e production (mínimo de 32 caracteres criptográficos)
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=30
JWT_REFRESH_TTL=30

# Login Social Google (Google Cloud Console OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Frontend (Next.js 14 App Router) & Vercel
# ATENÇÃO: Apenas variáveis com NEXT_PUBLIC_ são expostas ao navegador do usuário.
# NUNCA declare DATABASE_URL, REDIS_URL, SECRET_KEY ou VAPID_PRIVATE_KEY como NEXT_PUBLIC_.
# ------------------------------------------------------------------------------
# URL da API FastAPI acessível pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:8000
# Em staging (ex: Render / Railway / Fly.io / Cloud Run):
# NEXT_PUBLIC_API_URL=https://api-staging.elitedaspechinchas.com.br

# Forçar uso de dados mockados (somente se backend estiver offline)
NEXT_PUBLIC_USE_MOCK=false
APP_BASE_URL=http://localhost:3000

# Chave pública VAPID para subscrição Web Push no navegador (somente a pública!)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key

# ------------------------------------------------------------------------------
# 6. CORS (Backend FastAPI)
# ------------------------------------------------------------------------------
# Lista de origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://elitedaspechinchas.com.br
# Em staging, adicione a URL do preview da Vercel:
# CORS_ORIGINS=http://localhost:3000,https://elitedaspechinchas-staging.vercel.app

# Expressão regular opcional para permitir previews dinâmicos da Vercel em staging:
# CORS_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# ------------------------------------------------------------------------------
# 7. Automação de Captura Telegram (Telethon Userbot & Bot API)
# REGRA DE SEGURANÇA: Nunca conecte canais públicos em ambiente de staging.
# ------------------------------------------------------------------------------
# Obtenha API_ID e API_HASH em https://my.telegram.org/apps
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=seu_api_hash_do_telegram_aqui
TELEGRAM_SESSION_NAME=sessions/elitedaspechinchas_userbot

# Token do bot no Telegram para publicação de ofertas (@BotFather)
TELEGRAM_BOT_TOKEN=000000000:AAB_exemplo_token_bot_telegram

# Em staging: utilize EXCLUSIVAMENTE um canal privado de testes (ex: -100123456789 ou @staging_test_channel)
TARGET_CHANNEL_ID=@elitedaspechinchas_staging_privado

# Grupos/Canais fonte autorizados para captura (separados por vírgula)
SOURCE_CHANNELS=@staging_grupo_teste

# ------------------------------------------------------------------------------
# 8. Tags de Afiliado por Loja (Troca Automática de Links)
# Preencha com as suas tags oficiais de cada programa de afiliados.
# Se vazio, o sistema manterá o link original como fallback seguro.
# ------------------------------------------------------------------------------
AMAZON_TAG=sua_tag_associado_amazon
MERCADOLIVRE_TAG=sua_tag_mercadolivre
MAGALU_TAG=seu_parceiro_magalu
SHOPEE_TAG=sua_tag_shopee
KABUM_TAG=sua_tag_kabum
ALIEXPRESS_TAG=sua_tag_aliexpress

# ------------------------------------------------------------------------------
# 9. Motor de Regras e Curadoria
# ------------------------------------------------------------------------------
MIN_DISCOUNT_PERCENT=10
DEDUPLICATION_HOURS=24
MAX_OFFERS_PER_HOUR_PER_SOURCE=30
AUTO_APPROVE_ENABLED=false
AUTO_APPROVE_DISCOUNT_THRESHOLD=40

# ------------------------------------------------------------------------------
# 10. Web Push Notifications (VAPID)
# Gere novas chaves para cada ambiente com: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Backend:
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:admin@elitedaspechinchas.com.br
