# ==========================================
# Configurações do Web/Frontend Next.js
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# ==========================================
# Configurações do Backend FastAPI (Fase 3)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promoradar
REDIS_URL=redis://localhost:6379/0

# Autenticação JWT
JWT_SECRET=super_secret_promoradar_jwt_key_2026_change_in_production
JWT_ACCESS_TTL=30
JWT_REFRESH_TTL=30

# Login Social Google (Google Cloud Console OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# Web Push Notifications (VAPID)
# Gere suas chaves executando: vapid --gen ou via npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExamplePublicKey_ReplaceWithGeneratedVapidKey...
VAPID_PRIVATE_KEY=ExamplePrivateKey_ReplaceWithGeneratedKey...
VAPID_SUBJECT=mailto:admin@promoradar.com.br

# URLs e CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://elitedaspechinchas.com.br
APP_BASE_URL=http://localhost:3000

# ==========================================
# Automação de Captura Telegram (Telethon & Bot API)
# ==========================================
# Obtenha API_ID e API_HASH em https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION_NAME=elitedaspechinchas_userbot

# Token do bot no Telegram para postagem (@BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TARGET_CHANNEL_ID=@elitedaspechinchas

# Grupos/Canais fonte de onde capturar as promoções (separados por vírgula)
SOURCE_CHANNELS=@grupo_fonte_1,@grupo_fonte_2,@grupo_fonte_3

# Tags de Afiliado por Loja (Troca Automática de Links)
AMAZON_TAG=elitedaspechinchas-20
MERCADOLIVRE_TAG=elitedaspechinchas
MAGALU_TAG=elitedaspechinchas
SHOPEE_TAG=elitedaspechinchas
KABUM_TAG=elitedaspechinchas-20
ALIEXPRESS_TAG=elitedaspechinchas

# Regras de Curadoria & Filtro
MIN_DISCOUNT_PERCENT=10
DEDUPLICATION_HOURS=24
MAX_OFFERS_PER_HOUR_PER_SOURCE=30
AUTO_APPROVE_ENABLED=false
AUTO_APPROVE_DISCOUNT_THRESHOLD=40

