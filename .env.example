# ==============================================================================
# ELITE DAS PECHINCHAS — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL & Redis (Docker Compose & Local)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=elitedaspechinchas

# No Docker Compose, os hosts são 'postgres' e 'redis' (definidos na rede interna):
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/elitedaspechinchas
REDIS_URL=redis://redis:6379/0

# Para rodar localmente fora do Docker, use 'localhost':
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elitedaspechinchas
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 2. Web / Frontend Next.js 14
# ------------------------------------------------------------------------------
# URL pública acessível pelo navegador do usuário final para chamadas à API FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# URLs autorizadas pelo CORS no Backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://elitedaspechinchas.com.br
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Autenticação & Segurança (JWT & Google OAuth)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_elitedaspechinchas_jwt_key_2026_change_in_production
JWT_ACCESS_TTL=30
JWT_REFRESH_TTL=30

# Login Social Google (Google Cloud Console OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Gere seu par de chaves executando: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExamplePublicKey_ReplaceWithGeneratedVapidKey...
VAPID_PRIVATE_KEY=ExamplePrivateKey_ReplaceWithGeneratedKey...
VAPID_SUBJECT=mailto:admin@elitedaspechinchas.com.br

# ------------------------------------------------------------------------------
# 5. Automação de Captura Telegram (Telethon Userbot & Bot API)
# ------------------------------------------------------------------------------
# Obtenha API_ID e API_HASH em https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION_NAME=sessions/elitedaspechinchas_userbot

# Token do bot no Telegram para publicação de ofertas (@BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TARGET_CHANNEL_ID=@elitedaspechinchas

# Grupos/Canais fonte autorizados para captura (separados por vírgula)
SOURCE_CHANNELS=@grupo_fonte_1,@grupo_fonte_2,@grupo_fonte_3

# ------------------------------------------------------------------------------
# 6. Tags de Afiliado por Loja (Troca Automática de Links)
# ------------------------------------------------------------------------------
AMAZON_TAG=elitedaspechinchas-20
MERCADOLIVRE_TAG=elitedaspechinchas
MAGALU_TAG=elitedaspechinchas
SHOPEE_TAG=elitedaspechinchas
KABUM_TAG=elitedaspechinchas-20
ALIEXPRESS_TAG=elitedaspechinchas

# ------------------------------------------------------------------------------
# 7. Motor de Regras e Curadoria
# ------------------------------------------------------------------------------
MIN_DISCOUNT_PERCENT=10
DEDUPLICATION_HOURS=24
MAX_OFFERS_PER_HOUR_PER_SOURCE=30
AUTO_APPROVE_ENABLED=false
AUTO_APPROVE_DISCOUNT_THRESHOLD=40
