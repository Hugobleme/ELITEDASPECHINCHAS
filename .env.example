# ==========================================
# Configurações do Web/Frontend Next.js
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# ==========================================
# Configurações do Backend FastAPI (Fase 3)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promoradar
REDIS_URL=redis://localhost:6379/0

# Autenticação JWT
JWT_SECRET=super_secret_promoradar_jwt_key_2026_change_in_production
JWT_ACCESS_TTL=30
JWT_REFRESH_TTL=30

# Login Social Google (Google Cloud Console OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# Web Push Notifications (VAPID)
# Gere suas chaves executando: vapid --gen ou via npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExamplePublicKey_ReplaceWithGeneratedVapidKey...
VAPID_PRIVATE_KEY=ExamplePrivateKey_ReplaceWithGeneratedKey...
VAPID_SUBJECT=mailto:admin@promoradar.com.br

# URLs e CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://promoradar.com.br
APP_BASE_URL=http://localhost:3000
